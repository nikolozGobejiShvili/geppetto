<%- include('partials/top', { pageTitle: 'პაროლი' }) %>
<div class="page-head">
  <h1>პაროლის შეცვლა</h1>
</div>
<%- include('partials/notices') %>
<form method="post" action="/admin/password" class="panel stack narrow">
  <input type="text" name="username" value="admin" autocomplete="username" hidden>
  <label class="field">
    <span>მიმდინარე პაროლი</span>
    <input type="password" name="current_password" autocomplete="current-password" required>
  </label>
  <label class="field">
    <span>ახალი პაროლი (მინიმუმ <%= minLength %> სიმბოლო)</span>
    <input type="password" name="new_password" autocomplete="new-password" minlength="<%= minLength %>" required>
  </label>
  <label class="field">
    <span>ახალი პაროლი კიდევ ერთხელ</span>
    <input type="password" name="confirm_password" autocomplete="new-password" required>
  </label>
  <div><button class="button" type="submit">პაროლის შეცვლა</button></div>
</form>
<%- include('partials/bottom') %>
